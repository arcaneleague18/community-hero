rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /complaints/{userId}/{fileName} {
      // Allow reading complaint media to any signed-in user
      allow read: if request.auth != null;

      // Allow authenticated user to upload media under their own user UID path
      // Enforce 10MB max upload size and valid image/video content types
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|video/.*)');
    }
  }
}
